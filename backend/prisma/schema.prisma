generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  avatar        String?
  role               String          @default("USER") // System level role
  hashedRefreshToken String?         // Secure hashed refresh token for token rotation
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  tasks         Task[]
  messages      Message[]
  costs         Cost[]
  notifications Notification[]
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  roleGroups  RoleGroup[]
  sprints     Sprint[]
  tasks       Task[]
  costs       Cost[]
  channels    Channel[]
}

model RoleGroup {
  id          String          @id @default(uuid())
  name        String          // e.g. "Admin", "DEV", "QA", "Viewer"
  permissions String[]        // ["overview", "board", "backlog", "members", "chat", "cost", "settings"]
  isDefault   Boolean         @default(false)
  projectId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     ProjectMember[]

  @@unique([projectId, name])
}

model ProjectMember {
  id               String     @id @default(uuid())
  userId           String
  projectId        String
  roleGroupId      String?
  extraPermissions String[]   @default([]) // Individual additional tab permissions
  joinedAt         DateTime   @default(now())

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleGroup        RoleGroup? @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
}

model Sprint {
  id        String   @id @default(uuid())
  name      String   // e.g. "Sprint 1"
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  costs     Cost[]
}

model Task {
  id          String    @id @default(uuid())
  code        String?   // e.g. "FT-101"
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  points      Int?      @default(0)
  projectId   String
  assigneeId  String?
  sprintId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  sprint      Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
}

model Cost {
  id          String   @id @default(uuid())
  title       String
  category    String   // personnel, infrastructure, licenses, hardware, other
  amount      Float
  date        DateTime @default(now())
  status      String   @default("PAID") // PAID, APPROVED, PENDING
  projectId   String
  sprintId    String?
  requesterId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  requester   User?    @relation(fields: [requesterId], references: [id], onDelete: SetNull)
}

model Channel {
  id          String    @id @default(uuid())
  name        String    // "chung", "phat-trien", "sprint-1"
  description String?
  projectId   String
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([projectId, name])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  attachment String?
  reactions  Json?
  channelId  String
  userId     String
  createdAt  DateTime @default(now())

  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("INFO") // INFO, TASK, SPRINT, SYSTEM
  link      String?
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
